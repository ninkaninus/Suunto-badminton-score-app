{
  "name": "Badminton Scorer",
  "description": "Badminton scorekeeper using the BWF 3x15 scoring system. UP scores for your opponent, DOWN scores for you; hold either to undo. Tracks games, serve and court side for singles and doubles.",
  "author": "William Bergmann Børresen",
  "version": "3.0",
  "type": "feature",
  "usage": "workout",
  "modificationTime": 1784246400,
  "template": [
    { "name": "setup.html" },
    { "name": "score.html" },
    { "name": "match-over.html" }
  ],
  "out": [
    { "name": "playerOneScore", "log": true, "shownName": "Your score", "format": "Count_Twodigits" },
    { "name": "playerTwoScore", "log": true, "shownName": "Opp score", "format": "Count_Twodigits" },
    { "name": "activePlayer" },
    { "name": "game1Winner" },
    { "name": "game2Winner" },
    { "name": "setupFieldIdx" },
    { "name": "isDoubles" },
    { "name": "setupServesFirst" },
    { "name": "setupYouServeFirst" },
    { "name": "youOnRight" },
    { "name": "game1P1Score" },
    { "name": "game1P2Score" },
    { "name": "game2P1Score" },
    { "name": "game2P2Score" },
    { "name": "totalPoints", "log": true, "shownName": "Total points", "format": "Count_Threedigits" }
  ]
}
