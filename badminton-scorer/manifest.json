{
  "name": "Badminton Scorer",
  "description": "Full badminton scorer: BWF 3x15 games, live serve & court position, undo, and match stats.",
  "author": "William Bergmann Børresen",
  "version": "4.0",
  "type": "feature",
  "usage": "workout",
  "modificationTime": 1784325600,
  "template": [{ "name": "setup.html" }, { "name": "score.html" }, { "name": "match-over.html" }],
  "out": [
    { "name": "playerOneScore", "format": "Count_Twodigits", "log": true, "shownName": "Your score" },
    { "name": "playerTwoScore", "format": "Count_Twodigits", "log": true, "shownName": "Opp score" },
    { "name": "activePlayer" },
    { "name": "game1Winner" },
    { "name": "game2Winner" },
    { "name": "setupFieldIdx" },
    { "name": "isDoubles" },
    { "name": "setupServesFirst" },
    { "name": "setupYouServeFirst" },
    { "name": "youOnRight" },
    { "name": "game1P1Score" },
    { "name": "game1P2Score" },
    { "name": "game2P1Score" },
    { "name": "game2P2Score" },
    { "name": "totalPoints", "format": "Count_Threedigits", "log": true, "shownName": "Total points" }
  ]
}
